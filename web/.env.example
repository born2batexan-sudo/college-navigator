# Copy to web/.env and fill in. Never commit the real .env file.

# Leave DATABASE_URL unset (or commented out) for local dev — the app then
# uses Node's built-in node:sqlite with zero setup (see lib/db/client.ts).
# Set it to a real Postgres connection string (e.g. from Supabase — use the
# "Transaction pooler" connection string, port 6543, for serverless
# deployments like Vercel) to switch the whole app to Postgres.
# DATABASE_URL="postgres://user:password@host:6543/postgres"

# Shared secret the Python agents present when calling /api/agent/* routes.
# Must match agents/.env's AGENT_API_KEY exactly. Use a long random value
# in production, not this placeholder.
AGENT_API_KEY=dev-local-agent-key-change-me

# Only needed if you run the agents (they call the Anthropic API directly,
# not this app).
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Sign-in (workstream W1) ----
# Supabase project settings: Project Settings -> API. The URL and the public
# "anon" (publishable) key are meant to be public; the service key is NOT.
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# Optional. Lets "Delete my account" also remove the person's sign-in record.
# Secret: set it in Vercel only, never commit it.
# SUPABASE_SERVICE_ROLE_KEY="..."

# One-tap buttons on the sign-in page, comma separated. Leave empty until each
# provider's developer account and Supabase setting exist.
# Options: google, azure (Microsoft), apple, custom:yahoo
# AUTH_PROVIDERS="google"

# Email sign-in shows a 6-digit code box only when this is 1. Set it after custom
# mail is set up in Supabase and its email templates show {{ .Token }}. Until then
# the email holds a link only (it must be opened on the same browser).
# AUTH_EMAIL_CODE=1

# Local testing only: shows a "sign in as any email" box. Ignored in production builds.
# AUTH_DEV_LOGIN=1
