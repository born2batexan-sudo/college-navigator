# Copy to web/.env and fill in. Never commit the real .env file.

# Leave DATABASE_URL unset (or commented out) for local dev — the app then
# uses Node's built-in node:sqlite with zero setup (see lib/db/client.ts).
# Set it to a real Postgres connection string (e.g. from Supabase — use the
# "Transaction pooler" connection string, port 6543, for serverless
# deployments like Vercel) to switch the whole app to Postgres.
# DATABASE_URL="postgres://user:password@host:6543/postgres"

# Shared secret the Python agents present when calling /api/agent/* routes.
# Must match agents/.env's AGENT_API_KEY exactly. Use a long random value
# in production, not this placeholder.
AGENT_API_KEY=dev-general-agent-key-change-me
RESEARCH_WRITER_API_KEY=dev-research-writer-key-change-me
QUEUE_AGENT_API_KEY=dev-queue-worker-key-change-me
DIRECTORY_IMPORT_API_KEY=dev-directory-import-key-change-me

# Server-only Anthropic key for research agents and, only after a separate
# explicit assistant activation, Ask Campus Passage. Never NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Sign-in (workstream W1) ----
# Supabase project settings: Project Settings -> API. The URL and the public
# "anon" (publishable) key are meant to be public; the service key is NOT.
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# Optional. Lets "Delete my account" also remove the person's sign-in record.
# Secret: set it in Vercel only, never commit it.
# SUPABASE_SERVICE_ROLE_KEY="..."

# One-tap buttons on the sign-in page, comma separated. Leave empty until each
# provider's developer account and Supabase setting exist.
# Options: google, azure (Microsoft), apple, custom:yahoo
# AUTH_PROVIDERS="google"

# Email sign-in shows a 6-digit code box only when this is 1. Set it after custom
# mail is set up in Supabase and its email templates show {{ .Token }}. Until then
# the email holds a link only (it must be opened on the same browser).
# AUTH_EMAIL_CODE=1

# Local testing only: shows a "sign in as any email" box. Ignored in production builds.
# AUTH_DEV_LOGIN=1

# ---- Launch boundary: public marketing + manual private-preview approval ----
# REQUIRED server-side canonical origin for EVERY emailed/copyable link and Supabase
# callback. Exact scheme + host (+ optional port), no trailing slash/path/query.
# HTTPS is required except http://localhost:3000 for local testing. Configure
# this exact origin in Supabase's redirect allowlist as well. Never use forwarded
# Host headers for generated links.
# APP_ORIGIN="https://www.campuspassage.com"
# Server-only owner address: verified Supabase sign-in at this exact address
# bypasses the access gate and can manage /admin/demo. Required for owner access;
# leave unset only to fail closed.
# DEMO_OWNER_EMAIL="owner@example.com"
# Owner-only fictional review lab. Keep unset/false outside a controlled review session.
# The route also requires the DEMO_OWNER_EMAIL guard and is never public.
# CAMPUSPASSAGE_REVIEW_LAB_ENABLED=false
# Server-only household id used as the immutable preview template. Never expose this value to browsers.
# DEMO_TEMPLATE_HOUSEHOLD_ID="hh_template"

# Secret used to key access-request email/IP digests and abuse-control lookups.
# Required when the public request page runs in production. Use a unique random
# secret of at least 32 bytes, stored only in the deployment secret manager.
# REQUEST_ACCESS_HASH_SECRET="change-me-in-deployment"
# Restricted Resend key with sending-only access. Store only in the deployment
# secret manager; never prefix it with NEXT_PUBLIC_ or commit it.
# RESEND_API_KEY="re_..."
# Authenticated sender identity and optional monitored reply address.
# DEMO_EMAIL_FROM="Campus Passage <access@campuspassage.com>"
# DEMO_EMAIL_REPLY_TO="born2batexan@gmail.com"

# ---- Paid, forwarding-first email validation ----
# Non-secret routing domain for issued forwarding aliases. The alias itself is
# shown once to the owner; only its hash is stored by the application.
# EMAIL_FORWARDING_DOMAIN="inbound.example.com"
# Secret used to key replay digests. Use at least 32 random characters in the
# deployment secret store; never put the value in source control.
# EMAIL_VALIDATION_REPLAY_SECRET="change-me-in-deployment"
# Server-only capability secret for the future normalized-envelope adapter.
# No provider ingress is implemented until this is provisioned and reviewed.
# Use at least 32 random characters; never expose it to browsers.
# EMAIL_VALIDATION_NORMALIZER_SECRET="change-me-in-deployment"
# Comma-separated server-authenticated admin user IDs allowed to provision
# entitlements and curate/revoke sender policies. Caller labels are ignored.
# EMAIL_VALIDATION_ADMIN_USER_IDS="auth-user-id-1,auth-user-id-2"

# Reminder foundation is provider-neutral and dry-run by default. Do not set
# this until a reviewed delivery adapter, recipient approval, and staging
# verification exist; this flag alone performs no network call.
# REMINDER_PRODUCTION_DELIVERY_ENABLED=0

# ---- Owner foundations (review only, all integrations disabled) ----
# REQUIRED when issuing/revoking owner-approved complimentary access. Match
# every included student's enteringTerm; existing grants remain valid until
# their own expires_at or revocation, not merely when this setting changes.
# ACCESS_CYCLE="Fall 2027"
# Stripe is off unless all server-only settings exist and this is 1.
# STRIPE_REVIEW_ENABLED=0
# STRIPE_SECRET_KEY="sk_..."               # secret; never NEXT_PUBLIC_
# STRIPE_WEBHOOK_SECRET="whsec_..."         # secret; raw signed webhook only
# STRIPE_PRICE_ID="price_..."              # configured server-side; no client price
# STRIPE_EXPECTED_AMOUNT_CENTS="..."       # private reconciliation value
# STRIPE_EXPECT_LIVEMODE=0                  # 1 only after reviewed live activation
# Stripe-hosted Checkout may offer Apple Pay/Google Pay if merchant, device,
# domain and processor settings permit. No direct wallet handling is implemented.
# Google / Apple / Microsoft account sign-in: AUTH_PROVIDERS="google,apple,azure"
# Each provider requires independent Supabase developer setup and callback allowlisting.
# Connected mail is OFF by default. Enable only after reviewed PostgreSQL migration,
# Google restricted-scope verification/security assessment, Microsoft tenant consent,
# privacy/security review and mock + end-to-end staging verification. No credentials
# are configured in source; the flag alone cannot enable an unconfigured provider.
# CONNECTED_MAIL_ENABLED=0
# MAIL_TOKEN_ENCRYPTION_KEY="64-hex-character-server-only-key" # 32 random bytes, secret manager; preserve until all grants deleted/re-encrypted
# MAIL_GOOGLE_CLIENT_ID="..."
# MAIL_GOOGLE_CLIENT_SECRET="..."
# MAIL_MICROSOFT_CLIENT_ID="..."
# MAIL_MICROSOFT_CLIENT_SECRET="..."
# Register exact callbacks: APP_ORIGIN/api/mail/callback/gmail and
# APP_ORIGIN/api/mail/callback/microsoft. Google uses gmail.readonly (restricted;
# gmail.metadata cannot perform sender-scoped queries). Microsoft needs delegated
# Mail.ReadBasic, User.Read, offline_access; configure app consent/redirects.
# MAIL_MAINTENANCE_SECRET="at-least-32-random-characters" # server-only cron bearer
# Schedule POST APP_ORIGIN/api/mail/maintenance daily with that Authorization:
# Bearer secret. The route is inert (404) unless the secret is configured.
# Microsoft has no least-privilege per-app grant revocation endpoint; users must
# also remove the app from My Apps. Google revocation failure needs manual removal.
# Ask Campus Passage is OFF unless explicitly enabled after owner/security/privacy
# and staging review. This server-only switch gates both /ask and /api/ask.
# ASSISTANT_ENABLED=0
# Optional Anthropic extractive selector. Off: deterministic single-source quote
# only. On: requires ANTHROPIC_API_KEY; provider failure/abstention refuses.
# The model cannot author final answer text. Fixed Claude Haiku model, 8s timeout,
# max 128 output tokens, 5-cent reservation, 20 questions/$1 per household/day.
# ASSISTANT_MODEL_ENABLED=0

# Net-new school research: ALL OFF. Production requires reviewed migration,
# provider pricing/credentials, robots/security review and 60-school benchmark.
# REQUEST_QUEUE_ENABLED=0
# REQUEST_PIPELINE_ENABLED=0
# RESEARCH_API_ENABLED=0
# REQUEST_EVENT_DISPATCH_ENABLED=0  # separate server-only wake-up kill switch
# REQUEST_DISPATCH_REPOSITORY="owner/repo" # reviewed GitHub Actions repository
# REQUEST_DISPATCH_REF="main" # protected branch containing school-requests.yml
# REQUEST_DISPATCH_GITHUB_TOKEN="..." # server-only fine-grained token or GitHub App installation token, Actions:write on only this repo; NEVER NEXT_PUBLIC_
# REQUEST_MONTHLY_BUDGET_CENTS=1600
# REQUEST_JOB_ESTIMATE_CENTS=800
# REQUEST_LEASE_SECONDS=300  # choose >= provider + upload timeout; min 300
# Machine queue token remains server-only, never household credentials.
