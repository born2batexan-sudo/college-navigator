# Copy to agents/.env and fill in. Never commit the real .env file.

# Where the College Navigator web app is running.
APP_BASE_URL=http://localhost:3000

# Must match web/.env's AGENT_API_KEY exactly.
AGENT_API_KEY=dev-general-agent-key-change-me
RESEARCH_WRITER_API_KEY=dev-research-writer-key-change-me
QUEUE_AGENT_API_KEY=dev-queue-worker-key-change-me
DIRECTORY_IMPORT_API_KEY=dev-directory-import-key-change-me

# Your own Anthropic API key (console.anthropic.com). Required for all
# three agents — they call the Claude API directly, separate from
# whatever surface you're reading this in.
ANTHROPIC_API_KEY=

# Optional override; defaults to claude-sonnet-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-5

# New queue worker is inert until explicitly enabled after reviewed migration
# and 60-school 120-second/cost benchmark. Do not put household/campus credentials here.
REQUEST_PIPELINE_ENABLED=0
# Required only when enabled: licensed public search + chosen Anthropic model.
# BRAVE_SEARCH_API_KEY=
# REQUEST_RESEARCH_MODEL=
# REQUEST_SEARCH_COST_CENTS=1
# REQUEST_LANE_RESERVATION_CENTS=40
# REQUEST_INPUT_CENTS_PER_MILLION=300
# REQUEST_OUTPUT_CENTS_PER_MILLION=1500
# REQUEST_ATTEMPT_CEILING_CENTS=800
